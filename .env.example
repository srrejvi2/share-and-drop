# Optional local use: node --env-file=.env scripts/server.mjs
# Render supplies PORT. Do not set it in the Render dashboard.
PORT=3000
TRUST_PROXY=false

# Optional coturn-compatible service with use-auth-secret enabled.
# Set these in Render's Environment page. Never commit real secrets to GitHub.
# Every visitor receives short-lived relay credentials automatically.
# TURN_URLS=turn:relay.example.com:3478,turns:relay.example.com:5349
# TURN_SHARED_SECRET=replace-with-your-turn-server-shared-secret
# TURN_TTL_SECONDS=3600
